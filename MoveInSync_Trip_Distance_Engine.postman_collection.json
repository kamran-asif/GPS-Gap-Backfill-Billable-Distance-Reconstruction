      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Tenant-ID", "value": "moveinsync-client-1" },
          { "key": "X-User-Role", "value": "ROLE_ADMIN" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/v1/admin/circuit-breaker/trip",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "admin", "circuit-breaker", "trip"]
